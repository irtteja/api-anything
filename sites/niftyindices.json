{
  "name": "niftyindices",
  "displayName": "NSE Indices (niftyindices.com)",
  "baseUrl": "https://liveindexsa.niftyindices.com",
  "description": "NSE Indices Limited (formerly IISL). Live index and constituent data from liveindexsa.niftyindices.com (Azure CDN, no auth) and www.niftyindices.com. Includes index constituent CSVs, press releases (which announce upcoming additions/removals), and live intraday data.",
